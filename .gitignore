# Ignorar diretórios e arquivos fora do projeto
../*

# Ignorar arquivos temporários e de sistema
*.log
*.tmp
*.bak
.DS_Store

# Ignorar dependências e builds
node_modules/
dist/
build/
.expo/
*.apk
*.aab

# Ignorar arquivos de configuração do usuário
.vscode/
.idea/
*.code-workspace

# Ignorar arquivos de cache
.cache/
.gradle/
.m2/
.nuget/

# Ignorar arquivos específicos do Windows
AppData/
NTUSER.DAT*
ntuser.dat*
ntuser.ini

# Ignorar arquivos pessoais e downloads
Downloads/
Documents/
Videos/
Music/
OneDrive/
Favorites/
Links/
Searches/
Saved Games/

# Não ignorar os arquivos do projeto
!.gitignore
!App.tsx
!app.json
!assets/
!index.ts
!package-lock.json
!package.json
!src/
!tsconfig.json
!eas.json
.env
